/* ============ tokens ============ */
:root {
  --accent: oklch(54% 0.19 258);
  --accent-soft: oklch(94% 0.035 258);
  --accent-deep: oklch(38% 0.13 258);

  --ink: oklch(16% 0.015 260);
  --ink-2: oklch(24% 0.015 260);
  --ink-3: oklch(30% 0.018 260);
  --muted: oklch(38% 0.02 260);
  --muted-2: oklch(45% 0.02 260);
  --muted-3: oklch(50% 0.02 260);
  --line: oklch(90% 0.006 255);
  --bg: oklch(98.4% 0.003 250);
  --card-bg: oklch(99% 0.001 255);
  --white: oklch(99% 0.005 255);

  --banner-h: 38px;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: 'Manrope', sans-serif;
  overflow-x: hidden;
}

a { color: inherit; text-decoration: none; }
::selection { background: oklch(90% 0.05 258); }
img { max-width: 100%; }

h1, h2, h3 { font-family: 'Space Grotesk', sans-serif; margin: 0; }

/* ============ shared ============ */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14px 26px;
  border-radius: 100px;
  font-size: 16px;
  font-weight: 700;
  border: none;
  cursor: pointer;
  font-family: 'Manrope', sans-serif;
}
.btn--accent { background: var(--accent); color: var(--white); }
.btn--outline { background: transparent; border: 1.5px solid oklch(85% 0.01 260); color: var(--ink); }
.btn--outline-accent { background: transparent; border: 1.5px solid var(--accent); color: var(--accent); }
.btn--white { background: var(--white); color: var(--accent); }
.btn--block { width: 100%; margin-top: auto; padding: 13px 20px; font-size: 15px; }
.btn--sm { padding: 10px 20px; font-size: 15px; }

.section { max-width: 1180px; margin: 0 auto; padding: 56px 56px 24px; }
.section__head { text-align: center; margin-bottom: 36px; }
.section__head h2 { font-size: 38px; font-weight: 700; letter-spacing: -0.01em; margin: 0 0 14px; }
.section__head p { font-size: 17px; color: var(--muted); margin: 0; }
.section__title-center { font-size: 34px; font-weight: 700; letter-spacing: -0.01em; margin: 0 0 28px; text-align: center; }

.grid { display: grid; gap: 24px; align-items: stretch; }
.grid--3 { grid-template-columns: repeat(3, 1fr); }

.badge {
  position: absolute;
  padding: 5px 14px;
  border-radius: 100px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.03em;
  text-transform: uppercase;
}
.badge--top { top: -13px; left: 32px; background: var(--accent); color: var(--white); }
.badge--gold { top: -13px; right: 32px; background: #F2B705; color: var(--ink); font-weight: 800; }

/* ============ banner + nav ============ */
.banner {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 31;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 16px;
  background: var(--accent-deep);
  color: var(--white);
  font-size: 14px;
  font-weight: 700;
  text-align: center;
}
.banner__cta { text-decoration: underline; }

.nav {
  position: sticky;
  top: var(--banner-h);
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 56px;
  background: oklch(98.4% 0.003 250 / 0.85);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--line);
}
.nav__logo { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 19px; letter-spacing: -0.01em; }
.nav__links { display: flex; align-items: center; gap: 32px; }
.nav__links a:not(.btn) { font-size: 15px; font-weight: 600; color: var(--muted); }
.nav__toggle { display: none; }
.nav__mobile { display: none; }

.banner-spacer { height: var(--banner-h); }

/* ============ hero ============ */
.hero {
  max-width: 1180px;
  margin: 0 auto;
  padding: 48px 56px 40px;
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  grid-template-areas:
    "content media"
    "ctas    .";
  column-gap: 40px;
  position: relative;
}

.hero__content { grid-area: content; }

.eyebrow {
  display: inline-block;
  padding: 6px 14px;
  border-radius: 100px;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  margin-bottom: 22px;
}

.hero__title {
  font-size: 47px;
  line-height: 1.08;
  font-weight: 700;
  letter-spacing: -0.02em;
  margin: 0 0 18px;
}

.hero__lede { font-size: 19px; line-height: 1.55; color: var(--ink-3); font-weight: 600; margin: 0 0 18px; }
.hero__lede p { margin: 0; }
.hero__proof { font-size: 16.5px; line-height: 1.6; color: var(--muted); margin: 0 0 16px; }
.hero__disclaimer { font-size: 15px; line-height: 1.6; color: var(--muted-2); margin: 0; }
.hero__ctas { grid-area: ctas; display: flex; gap: 14px; flex-wrap: wrap; margin-top: 32px; }

.hero__media { grid-area: media; position: relative; display: flex; justify-content: center; height: 100%; }
.hero__photo {
  height: 100%;
  width: auto;
  max-width: 100%;
  aspect-ratio: 359 / 547;
  object-fit: cover;
  object-position: 50% 15%;
  display: block;
}
.hero__linkedin {
  position: absolute;
  bottom: 8px;
  right: 8px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 16px;
  border-radius: 100px;
  background: var(--white);
  box-shadow: 0 12px 30px -10px oklch(20% 0.02 260 / 0.35);
  font-size: 14px;
  font-weight: 700;
  color: var(--ink);
  width: fit-content;
}
.linkedin-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  border-radius: 5px;
  background: #0A66C2;
  color: white;
  font-size: 12px;
  font-weight: 800;
  font-family: 'Space Grotesk', sans-serif;
}

/* ============ credibility ============ */
.credibility { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 32px 56px; }
.credibility__inner { max-width: 760px; margin: 0 auto; text-align: center; }
.chips { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-bottom: 20px; }
.chip { padding: 6px 14px; border-radius: 100px; background: var(--accent-soft); color: var(--accent); font-size: 13px; font-weight: 700; }
.credibility__text { font-size: 17px; line-height: 1.6; color: var(--ink-3); }
.credibility__text p { margin: 0 0 16px; }
.credibility__text p:last-child { margin-bottom: 0; }

/* ============ cards (products + services) ============ */
.card {
  display: flex;
  flex-direction: column;
  padding: 32px;
  border-radius: 20px;
  background: var(--card-bg);
  border: 1.5px solid var(--line);
  position: relative;
}
.card--bundle,
.card--featured { border-color: var(--accent); }

.card__tag { font-size: 13px; font-weight: 700; color: var(--accent); letter-spacing: 0.03em; text-transform: uppercase; margin-bottom: 10px; }
.card__title { font-size: 21px; font-weight: 700; margin: 0 0 10px; letter-spacing: -0.01em; }
.card__title--lg { font-size: 23px; }
.card__price { font-family: 'Space Grotesk', sans-serif; font-size: 30px; font-weight: 700; margin-bottom: 14px; }
.card__desc { font-size: 14.5px; line-height: 1.55; color: var(--muted); margin: 0 0 22px; flex: 1; }
.card__includes-label { font-size: 13px; font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase; color: var(--muted-3); margin: 0 0 12px; }

.gift {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  border-radius: 12px;
  background: var(--accent-soft);
  margin-bottom: 22px;
}
.gift__icon { position: relative; width: 22px; height: 22px; flex: none; display: block; }
.gift__icon-lid { position: absolute; top: 2px; left: 0; width: 100%; height: 6px; background: var(--accent); border-radius: 3px; }
.gift__icon-box { position: absolute; top: 8px; left: 1px; width: 20px; height: 13px; background: var(--card-bg); border: 2px solid var(--accent); border-radius: 0 0 3px 3px; }
.gift__icon-ribbon { position: absolute; top: 2px; bottom: 1px; left: 50%; width: 3px; background: var(--accent); transform: translateX(-50%); }
.gift__icon-bow { position: absolute; top: -2px; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
.gift__icon-bow--l { left: 3px; }
.gift__icon-bow--r { right: 3px; }
.gift__label { font-size: 13.5px; font-weight: 700; color: var(--ink-2); }

.dot-list { display: flex; flex-direction: column; gap: 10px; margin-bottom: 22px; flex: 1; }
.dot-list__item { display: flex; gap: 10px; font-size: 14.5px; color: var(--ink-2); }
.dot { flex: none; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); margin-top: 7px; }
.dot--white { background: var(--white); }

.card__price-row { display: flex; align-items: baseline; gap: 8px; margin-bottom: 18px; }
.card__unit { font-size: 14px; color: var(--muted-2); }
.card__pitch { font-size: 14.5px; line-height: 1.5; color: var(--muted); margin: 0 0 16px; }
.hr { height: 1px; background: var(--line); margin-bottom: 16px; }
.label { font-size: 12.5px; font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase; color: var(--muted-3); margin-bottom: 12px; }

.check-list { display: flex; flex-direction: column; gap: 10px; margin-bottom: 22px; }
.check-list__item { display: flex; gap: 10px; font-size: 14px; line-height: 1.4; color: var(--ink-2); }
.check { flex: none; color: var(--accent); font-weight: 800; font-size: 13px; line-height: 1.4; }

.result-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: 28px; }
.result-list__item { font-size: 14px; line-height: 1.5; font-weight: 600; color: var(--ink); }

.card__cta { margin-top: auto; }

.bundle-bar {
  margin-top: 28px;
  padding: 20px 28px;
  border-radius: 16px;
  background: var(--accent-soft);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 14px;
}
.bundle-bar__text { font-size: 15px; font-weight: 600; color: var(--ink-2); }

/* ============ partnership ============ */
.partnership {
  position: relative;
  border-radius: 24px;
  background: var(--accent-deep);
  padding: 52px;
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 48px;
}
.partnership__eyebrow {
  display: inline-block;
  padding: 6px 14px;
  border-radius: 100px;
  background: oklch(24% 0.02 260 / 0.3);
  color: var(--white);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  margin-bottom: 18px;
}
.partnership__title { font-size: 32px; font-weight: 700; letter-spacing: -0.01em; color: var(--white); margin: 0 0 14px; }
.partnership__price { font-family: 'Space Grotesk', sans-serif; font-size: 26px; font-weight: 700; color: var(--white); margin-bottom: 6px; }
.partnership__price-sub { font-size: 14px; color: oklch(88% 0.03 260); margin-bottom: 20px; }
.partnership__desc { font-size: 15px; line-height: 1.6; color: oklch(88% 0.03 260); margin: 0 0 20px; }

.partnership__right { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
.partnership__item { display: flex; gap: 10px; font-size: 14px; line-height: 1.5; color: oklch(94% 0.008 260); }

/* ============ FAQ ============ */
.section--faq { max-width: 1040px; padding: 0 56px 56px; }
.faq-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; align-items: start; }
.faq-item { border: 1px solid var(--line); border-radius: 14px; overflow: hidden; background: var(--card-bg); }
.faq-item__q {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 18px 22px;
  cursor: pointer;
  background: none;
  border: none;
  width: 100%;
  text-align: left;
  font-family: 'Manrope', sans-serif;
}
.faq-item__q-text { font-size: 15.5px; font-weight: 700; color: var(--ink); }
.faq-item__sign { flex: none; font-size: 20px; font-weight: 400; color: var(--accent); }
.faq-item__a { padding: 0 22px 20px; font-size: 14.5px; line-height: 1.6; color: var(--muted); white-space: pre-line; }

/* ============ contact ============ */
.contact { background: oklch(14% 0.02 260); padding: 64px 56px; }
.contact__inner { max-width: 1000px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
.contact__info h2 { font-size: 36px; font-weight: 700; letter-spacing: -0.01em; color: var(--white); margin: 0 0 16px; }
.contact__info p { font-size: 16px; line-height: 1.6; color: oklch(70% 0.015 260); margin: 0 0 22px; max-width: 400px; }
.contact__bonus { font-size: 14.5px; color: oklch(70% 0.015 260); }
.contact__bonus strong { color: var(--white); }

.social-row { display: flex; gap: 16px; margin-top: 24px; }
.social-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 1.5px solid oklch(40% 0.02 260);
  color: var(--white);
}

.contact__form { display: flex; flex-direction: column; gap: 12px; }
.contact__form[hidden] { display: none; }
.contact__form input,
.contact__form textarea {
  padding: 14px 16px;
  border-radius: 10px;
  border: 1px solid oklch(30% 0.015 260);
  background: oklch(20% 0.015 260);
  color: var(--white);
  font-size: 15px;
  font-family: 'Manrope', sans-serif;
}
.contact__form textarea { resize: vertical; }
.contact__form ::placeholder { color: oklch(55% 0.015 260); }
.contact__form .btn { margin-top: 6px; }

.contact__thanks { padding: 28px; border-radius: 16px; background: oklch(20% 0.015 260); color: var(--white); }
.contact__thanks-title { font-weight: 700; font-size: 17px; margin-bottom: 8px; }
.contact__thanks-sub { font-size: 14.5px; color: oklch(70% 0.015 260); line-height: 1.5; }
.contact__thanks-sub a { text-decoration: underline; }

/* ============ footer ============ */
.footer { padding: 36px 56px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; }
.footer__logo { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 16px; }
.footer__links { display: flex; gap: 28px; flex-wrap: wrap; }
.footer__links a { font-size: 14px; font-weight: 600; color: var(--muted-2); }
.footer__copy { font-size: 13px; color: oklch(55% 0.015 260); }

/* ============ responsive ============ */
@media (max-width: 980px) {
  .nav { padding: 16px 24px; }
  .nav__links { display: none; }
  .nav__toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }
  .nav__toggle span { display: block; height: 2px; background: var(--ink); border-radius: 2px; }
  .nav__mobile {
    display: none;
    flex-direction: column;
    gap: 4px;
    padding: 8px 24px 20px;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: calc(var(--banner-h) + 65px);
    z-index: 19;
  }
  .nav__mobile.is-open { display: flex; }
  .nav__mobile a:not(.btn) { padding: 10px 0; font-size: 15px; font-weight: 600; color: var(--muted); }
  .nav__mobile .btn { margin-top: 8px; align-self: flex-start; }

  .hero {
    grid-template-columns: 1fr;
    grid-template-areas: "media" "content" "ctas";
    padding: 32px 24px;
  }
  .hero__media { margin-bottom: 12px; height: auto; }
  .hero__photo { height: auto; width: 100%; max-width: 260px; margin: 0 auto; }
  .hero__title { font-size: 34px; }
  .hero__lede { font-size: 17px; }

  .credibility { padding: 28px 24px; }

  .section { padding: 40px 24px 24px; }
  .grid--3 { grid-template-columns: 1fr; }

  .partnership { grid-template-columns: 1fr; padding: 32px 24px; gap: 28px; }
  .partnership__right { grid-template-columns: 1fr; }

  .section--faq { padding: 0 24px 40px; }
  .faq-grid { grid-template-columns: 1fr; }

  .contact { padding: 48px 24px; }
  .contact__inner { grid-template-columns: 1fr; gap: 32px; }

  .footer { padding: 28px 24px; justify-content: flex-start; }
}
